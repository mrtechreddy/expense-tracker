<% layout('layout') %>
<div class="card p-3 shadow-lg">
  <h4>All Expenses</h4>
  <table class="table mt-3">
    <thead><tr><th>Date</th><th>Category</th><th>Amount</th></tr></thead>
    <tbody>
      <% expenses.forEach(e => { %>
        <tr>
          <td><%= e.date %></td>
          <td><%= e.category %></td>
          <td>₹<%= Number(e.amount).toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <a href="/dashboard" class="btn btn-link">Back</a>
</div>

