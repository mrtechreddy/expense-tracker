<% layout('layout') %>
<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card p-4 shadow-lg">
      <h3 class="mb-3">➕ Add Expense</h3>
      <form method="POST" action="/add">
        <div class="mb-3">
          <label class="form-label">Category</label>
          <select name="category" class="form-select">
            <option>Gas</option><option>Rent</option><option>Electricity</option><option>Fuel</option><option>Mobile</option>
            <option>Groceries</option><option>Food & Dining</option><option>Transportation</option><option>Healthcare</option><option>Education</option>
            <option>Entertainment</option><option>Shopping</option><option>Insurance</option><option>Travel</option>
            <option>Maintenance</option><option>Internet</option><option>Water</option><option>Subscription Services</option><option>Others</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Amount</label>
          <input name="amount" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Date</label>
          <input name="date" type="date" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" />
        </div>
        <button class="btn btn-gradient w-100">Save Expense</button>
      </form>
      <a href="/dashboard" class="btn btn-link mt-3">Back to dashboard</a>
    </div>
  </div>
</div>

